# ============================================================
# Prism AI Agent — muhit o'zgaruvchilari (namuna)
# Bu faylni `.env` deb nusxalab, qiymatlarni to'ldiring.
# HECH QACHON haqiqiy kalitlarni kodga yozmang — faqat shu yerda.
# ============================================================

# ---- Anthropic (Claude) — orkestrator miyasi ----
ANTHROPIC_API_KEY=sk-ant-xxxxx
# Orkestrator ishlatadigan model
CLAUDE_MODEL=claude-opus-4-8
# Claude javobi uchun maksimal token
CLAUDE_MAX_TOKENS=4096

# ---- OpenAI — Whisper (ovoz/video -> matn) va embedding ----
OPENAI_API_KEY=sk-xxxxx
EMBEDDING_MODEL=text-embedding-3-small
WHISPER_MODEL=whisper-1

# ---- Telegram bot (aiogram, long polling) ----
# @BotFather'dan olingan token
TELEGRAM_BOT_TOKEN=123456:ABC-xxxxx
# Botga faqat shu foydalanuvchi(lar) yoza olsin (Telegram user ID, vergul bilan)
TELEGRAM_ALLOWED_USER_IDS=111111111
# Guruh monitoring topilmalari yuboriladigan shaxsiy chat ID (odatda o'zingiznikidan)
TELEGRAM_OWNER_CHAT_ID=111111111

# ---- Telethon userbot (guruh monitoring, shaxsiy akkount) ----
# https://my.telegram.org -> API development tools
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Sessiya fayli nomi (shaxsiy akkount kaliti shu faylda saqlanadi)
TELETHON_SESSION_NAME=prism_userbot

# ---- Supabase (Postgres + pgvector) ----
SUPABASE_URL=https://xxxxx.supabase.co
# service_role kaliti (server tomonda, RLS'dan o'tadi — maxfiy tuting)
SUPABASE_SERVICE_KEY=eyJxxxxx

# ---- Replicate (rasm generatsiya: Flux / Ideogram) ----
REPLICATE_API_TOKEN=r8_xxxxx
# Ishlatiladigan model (masalan: black-forest-labs/flux-1.1-pro)
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-1.1-pro

# ---- Obsidian RAG sync (02_obsidian_rag_sync.py uchun) ----
# Obsidian vault papkasining to'liq yo'li (Mac mini'da)
OBSIDIAN_VAULT_PATH=/Users/you/Obsidian/PrismVault

# ---- Ism matching (guruh monitoring uchun) ----
# Guruhlarda qidiriladigan ismingiz variantlari, vergul bilan ajratilgan
# masalan: Maks,Maks Tur,Maksim,Максим
MONITOR_NAME_VARIANTS=Maks,Maks Tur,Maksim
